# Server Port (Render sets this automatically)
PORT=5000

# Allowed Frontend Origins
# Supports a single URL or comma-separated origins for production and local development
# Example: http://localhost:5173,https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173

# YouTube Data API v3 Configuration
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
YOUTUBE_UPLOADS_PLAYLIST_ID=your_youtube_uploads_playlist_id_here
